BIND_ADDRESS=192.168.50.10
GUI_PORT=13001
API_PORT=18080
GUI_USER=opencli
PUID=1026
PGID=100
TZ=America/Los_Angeles

# Local quick start: state lives beside compose.yaml. On NAS, set this to the
# existing absolute directory (for example /volume1/docker/opencli-backend)
# before rendering or starting Compose.
OPENCLI_RUNTIME_ROOT=.
OPENCLI_ALLOWED_COMMANDS=hackernews.top,bilibili.hot,xiaohongshu.whoami,twitter.whoami
OPENCLI_AUTO_ALLOW_READS=true
OPENCLI_DENIED_ARGUMENTS=include-sensitive,token,password,secret,cookie
OPENCLI_MAX_CONCURRENCY=2
OPENCLI_MAX_QUEUED_JOBS=100
OPENCLI_MAX_SUBMISSIONS_PER_MINUTE=60
OPENCLI_MAX_WAIT_SECONDS=120
OPENCLI_DEFAULT_TIMEOUT_SECONDS=120
OPENCLI_MAX_TIMEOUT_SECONDS=1800
OPENCLI_MAX_OUTPUT_BYTES=1048576
OPENCLI_WATCHDOG_GRACE_SECONDS=30
OPENCLI_SESSION_CHECK_SITES=xiaohongshu,twitter
OPENCLI_SESSION_CHECK_INTERVAL_SECONDS=900
